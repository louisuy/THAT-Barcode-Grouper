{
    "appId": "com.thatbrcodegrouper.app",
    "productName": "Barcode Grouper",
    "directories": {
        "output": "dist",
        "buildResources": "build"
    },
    "files": [
        "dist/**/*",
        "dist-electron/**/*"
    ],
    "publish": {
        "provider": "github",
        "owner": "louisuy",
        "repo": "THAT-Barcode-Grouper"
    },
    "win": {
        "target": "nsis",
        "signAndEditExecutable": false
    },
    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true
    }
}